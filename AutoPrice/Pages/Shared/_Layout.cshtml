<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;600;700;800;900&family=Barlow:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <nav>
        <a asp-page="/Index"><img class="logo" src="~/img/Logo_AP.png" /></a>
        <div class="nav-links">
            <a asp-page="/Auto/Catalogo">Comprar</a>

            <div class="nav-dropdown" id="dropdown-vender">
                <a href="#" onclick="toggleDropdown('dropdown-vender'); return false;">Vender</a>
                <div class="nav-dropdown-menu">
                    <a asp-page="/Auto/Vender" asp-route-tipo="Carro">🚗 Carros</a>
                    <a asp-page="/Auto/Vender" asp-route-tipo="Mota">🏍 Motas</a>
                </div>
            </div>

            <div class="nav-dropdown" id="dropdown-avaliar">
                <a href="#" onclick="toggleDropdown('dropdown-avaliar'); return false;">Avaliar</a>
                <div class="nav-dropdown-menu">
                    <a asp-page="/Avaliar" asp-route-tipo="Carro">🚗 Carros</a>
                    <a asp-page="/Avaliar" asp-route-tipo="Mota">🏍 Motas</a>
                </div>
            </div>

            @if (Context.Request.Cookies["token"] != null)
            {
                var fotoUser = Context.Request.Cookies["fotoUrl"];
                var nomeUser = Context.Request.Cookies["nomeCompleto"] ?? "User";
                var fotoSrc = string.IsNullOrEmpty(fotoUser)
                ? "https://ui-avatars.com/api/?name=" + Uri.EscapeDataString(nomeUser) + "&background=c9a84c&color=000&size=200"
                : fotoUser;

                <a asp-page="/Mensagens/Index" class="nav-msg-link" title="Mensagens">
                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
                    </svg>
                    <span class="nav-msg-badge" id="msg-badge"></span>
                </a>

                <a asp-page="/Auth/Perfil">
                    <img src="@fotoSrc" class="user-icon" title="@nomeUser" />
                </a>
                <a asp-page="/Auth/Logout">Sair</a>
            }
            else
            {
                <a asp-page="/Auth/Login">Entrar</a>
                <a asp-page="/Auth/Registo">Registar</a>
            }
        </div>
    </nav>

    @RenderBody()

    <footer>
        <div class="footer-nav">
            <a asp-page="/Index">Carros</a>
            <a asp-page="/Index">Motas</a>
            <a asp-page="/Index">Sobre</a>
        </div>
        <div class="social-row">
            <a asp-page="/Index" title="Email"><img class="social-icon" src="~/img/icons/email.png" /></a>
            <a asp-page="/Index" class="social-icon" title="Instagram">&#xf16d;</a>
            <a asp-page="/Index" class="social-icon" title="YouTube">&#xf167;</a>
        </div>
        <div class="footer-copy">
            &copy; 2026 AutoPrice. Todos os direitos reservados.
        </div>
    </footer>

    <script>
        function toggleDropdown(id) {
            const dropdown = document.getElementById(id);
            const isOpen = dropdown.classList.contains('open');
            document.querySelectorAll('.nav-dropdown').forEach(d => d.classList.remove('open'));
            if (!isOpen) dropdown.classList.add('open');
        }
        document.addEventListener('click', function (e) {
            if (!e.target.closest('.nav-dropdown'))
                document.querySelectorAll('.nav-dropdown').forEach(d => d.classList.remove('open'));
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>