@page
@model AutoPrice.Pages.Auth.LoginModel

@{
    ViewData["Title"] = "Entrar";
}

@section Styles {
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
}

<div class="auth-wrapper">
    <div class="auth-card">
        <h2 class="auth-title">Entrar na conta</h2>
        <p class="auth-sub">Bem-vindo de volta à AutoPrice</p>

        @if (Model.Erro != null)
        {
            <div class="auth-erro">@Model.Erro</div>
        }

        <form method="post">
            <div class="form-group">
                <label>Email</label>
                <input type="email" asp-for="Email" placeholder="o-seu@email.com" required />
            </div>
            <div class="form-group">
                <label>Password</label>
                <input type="password" asp-for="Password" placeholder="••••••••" required />
            </div>
            <button type="submit" class="btn-auth">Entrar</button>
        </form>

        <p class="auth-link">
            Não tem conta? <a asp-page="/Auth/Registo">Criar conta</a>
        </p>
    </div>
</div>