@page
@model AutoPrice.Pages.EditarPerfilModel

@{
    ViewData["Title"] = "Editar Perfil";
    var nome = string.IsNullOrEmpty(Model.NomeCompleto) ? "User" : Model.NomeCompleto;
    var fotoAtual = string.IsNullOrEmpty(Model.FotoUrl)
        ? "https://ui-avatars.com/api/?name=" + Uri.EscapeDataString(nome) + "&background=c9a84c&color=000&size=200"
        : Model.FotoUrl;
}

@section Styles {
    <link rel="stylesheet" href="~/css/editarperfil.css" asp-append-version="true" />
}

<div class="editar-wrapper">
    <h1 class="editar-title">Editar <span>Perfil</span></h1>
    <p class="editar-sub">Atualiza as tuas informações pessoais.</p>

    @if (!string.IsNullOrEmpty(Model.Sucesso))
    {
        <div class="editar-alert sucesso">✓ @Model.Sucesso</div>
    }
    @if (!string.IsNullOrEmpty(Model.Erro))
    {
        <div class="editar-alert erro">✕ @Model.Erro</div>
    }

    <form method="post" enctype="multipart/form-data">

        <!-- FOTO DE PERFIL -->
        <div class="editar-card">
            <div class="editar-section-title">Foto de Perfil</div>
            <div class="foto-section">
                <div class="foto-preview-wrap">
                    <img id="foto-preview" class="foto-preview"
                         src="@fotoAtual" alt="Foto de perfil" />
                    <label class="foto-upload-label" for="foto-input" title="Alterar foto">✎</label>
                    <input type="file" id="foto-input" name="FotoFicheiro"
                           class="foto-input" accept="image/jpeg,image/png,image/webp"
                           onchange="previewFoto(this)" />
                </div>
                <span id="foto-nome" class="foto-nome">Clica no ícone para alterar a foto</span>
                <span class="foto-nome">JPG, PNG ou WEBP · Máximo 5MB</span>
            </div>
        </div>

        <!-- INFORMAÇÕES PESSOAIS -->
        <div class="editar-card">
            <div class="editar-section-title">Informações Pessoais</div>
            <div class="editar-grid">
                <div class="form-group full">
                    <label>Nome Completo</label>
                    <input type="text" asp-for="NomeCompleto"
                           placeholder="Deixa em branco para manter o atual" />
                </div>
                <div class="form-group full">
                    <label>Email</label>
                    <input type="email" value="@Model.Email" disabled />
                </div>
                <div class="form-group">
                    <label>Telefone</label>
                    <input type="tel" asp-for="Telefone" placeholder="9XXXXXXXX" />
                </div>
                <div class="form-group">
                    <label>Localização</label>
                    <input type="text" asp-for="Localizacao" placeholder="Ex: Lisboa" />
                </div>
            </div>
        </div>

        <!-- ALTERAR PASSWORD -->
        <div class="editar-card">
            <div class="editar-section-title">Alterar Password</div>
            <div class="editar-grid">
                <div class="form-group full">
                    <label>Password Atual</label>
                    <input type="password" asp-for="PasswordAtual"
                           placeholder="Obrigatório para alterar a password" />
                    <span class="pass-hint">Deixa em branco se não queres alterar a password.</span>
                </div>
                <div class="form-group">
                    <label>Nova Password</label>
                    <input type="password" asp-for="NovaPassword" placeholder="Mínimo 6 caracteres" />
                </div>
                <div class="form-group">
                    <label>Confirmar Nova Password</label>
                    <input type="password" asp-for="ConfirmarPassword" placeholder="Repetir nova password" />
                </div>
            </div>
        </div>

        <div class="btn-row">
            <a asp-page="/Auth/Perfil" class="btn-cancelar">Cancelar</a>
            <button type="submit" class="btn-guardar">Guardar Alterações</button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        function previewFoto(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = e => {
                    document.getElementById('foto-preview').src = e.target.result;
                };
                reader.readAsDataURL(input.files[0]);
                document.getElementById('foto-nome').textContent = input.files[0].name;
            }
        }
    </script>
}
