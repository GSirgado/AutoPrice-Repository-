@page
@model AutoPrice.Pages.AvaliarModel

@{
    ViewData["Title"] = "Avaliar Veículo";
}

@section Styles {
    <style>
        .avaliar-wrapper {
            max-width: 800px;
            margin: 0 auto;
            padding: 40px 20px 80px;
        }

        .avaliar-title {
            font-family: 'Barlow Condensed', sans-serif;
            font-size: 2.2rem;
            font-weight: 900;
            text-transform: uppercase;
            color: #fff;
            margin-bottom: 8px;
        }

            .avaliar-title span {
                color: #c9a84c;
            }

        .avaliar-sub {
            color: #888;
            margin-bottom: 40px;
        }

        .avaliar-card {
            background: #1a1a1a;
            border: 1px solid #2a2a2a;
            border-radius: 16px;
            padding: 40px;
            margin-bottom: 20px;
        }

        .avaliar-section-title {
            font-family: 'Barlow Condensed', sans-serif;
            font-size: 1rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #c9a84c;
            margin-bottom: 20px;
            padding-bottom: 10px;
            border-bottom: 1px solid #2a2a2a;
        }

        .avaliar-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

            .form-group.full {
                grid-column: 1 / -1;
            }

            .form-group label {
                font-size: .78rem;
                font-weight: 600;
                color: #888;
                text-transform: uppercase;
                letter-spacing: 1px;
            }

            .form-group input,
            .form-group select {
                background: #111;
                border: 1px solid #2a2a2a;
                border-radius: 8px;
                color: #fff;
                font-family: 'Barlow', sans-serif;
                font-size: .95rem;
                padding: 12px 14px;
                transition: border-color .2s;
                box-sizing: border-box;
                width: 100%;
            }

                .form-group input:focus,
                .form-group select:focus {
                    outline: none;
                    border-color: #c9a84c;
                }

                .form-group select option {
                    background: #1a1a1a;
                }

        .btn-avaliar {
            width: 100%;
            background: #c9a84c;
            color: #000;
            border: none;
            border-radius: 8px;
            padding: 16px;
            font-size: 1rem;
            font-weight: 700;
            font-family: 'Barlow Condensed', sans-serif;
            letter-spacing: 1px;
            text-transform: uppercase;
            cursor: pointer;
            transition: background .2s;
            margin-top: 8px;
        }

            .btn-avaliar:hover {
                background: #e0bc5a;
            }

        /* Resultado */
        .resultado-card {
            background: linear-gradient(135deg, #1a1a1a, #222);
            border: 1px solid #c9a84c;
            border-radius: 16px;
            padding: 40px;
            margin-bottom: 20px;
            text-align: center;
        }

        .resultado-label {
            font-size: .85rem;
            color: #888;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 8px;
        }

        .resultado-preco {
            font-family: 'Barlow Condensed', sans-serif;
            font-size: 3.5rem;
            font-weight: 900;
            color: #c9a84c;
            margin-bottom: 8px;
        }

        .resultado-range {
            color: #888;
            font-size: .9rem;
            margin-bottom: 24px;
        }

            .resultado-range span {
                color: #fff;
            }

        .resultado-badge {
            display: inline-block;
            background: rgba(201,168,76,.15);
            border: 1px solid rgba(201,168,76,.4);
            color: #c9a84c;
            font-family: 'Barlow Condensed', sans-serif;
            font-size: 1rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 2px;
            padding: 6px 20px;
            border-radius: 20px;
            margin-bottom: 24px;
        }

        .resultado-detalhes {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 16px;
            margin-top: 24px;
            text-align: left;
        }

        .detalhe-item {
            background: #111;
            border: 1px solid #2a2a2a;
            border-radius: 8px;
            padding: 14px;
        }

        .detalhe-label {
            font-size: .72rem;
            color: #888;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 4px;
        }

        .detalhe-valor {
            font-family: 'Barlow Condensed', sans-serif;
            font-size: 1.1rem;
            font-weight: 800;
            color: #fff;
        }

        .resultado-aviso {
            font-size: .78rem;
            color: #555;
            margin-top: 20px;
        }

        .btn-vender {
            display: inline-block;
            background: transparent;
            border: 1px solid #c9a84c;
            color: #c9a84c;
            border-radius: 8px;
            padding: 12px 28px;
            font-family: 'Barlow', sans-serif;
            font-size: .9rem;
            font-weight: 600;
            text-decoration: none;
            transition: all .2s;
            margin-top: 16px;
        }

            .btn-vender:hover {
                background: #c9a84c;
                color: #000;
            }

        @@media (max-width: 600px) {
            .avaliar-grid {
                grid-template-columns: 1fr;
            }

            .resultado-detalhes {
                grid-template-columns: 1fr;
            }

            .avaliar-card {
                padding: 24px;
            }

            .resultado-preco {
                font-size: 2.5rem;
            }
        }
    </style>
}

<div class="avaliar-wrapper">
    <h1 class="avaliar-title">Avaliar <span>Veículo</span></h1>
    <p class="avaliar-sub">Obtém uma estimativa de preço de mercado para o teu veículo.</p>

    @if (Model.Avaliado)
    {
        <div class="resultado-card">
            <div class="resultado-label">Valor estimado de mercado</div>
            <div class="resultado-preco">€@Model.PrecoEstimado!.Value.ToString("N0")</div>
            <div class="resultado-range">
                Entre <span>€@Model.PrecoMinimo!.Value.ToString("N0")</span>
                e <span>€@Model.PrecoMaximo!.Value.ToString("N0")</span>
            </div>
            <div class="resultado-badge">@Model.Classificacao</div>

            <div class="resultado-detalhes">
                <div class="detalhe-item">
                    <div class="detalhe-label">Veículo</div>
                    <div class="detalhe-valor">@Model.Marca @Model.Modelo</div>
                </div>
                <div class="detalhe-item">
                    <div class="detalhe-label">Ano</div>
                    <div class="detalhe-valor">@Model.Ano</div>
                </div>
                <div class="detalhe-item">
                    <div class="detalhe-label">Quilómetros</div>
                    <div class="detalhe-valor">@Model.Kilometragem.ToString("N0") km</div>
                </div>
                <div class="detalhe-item">
                    <div class="detalhe-label">Combustível</div>
                    <div class="detalhe-valor">@Model.Combustivel</div>
                </div>
                <div class="detalhe-item">
                    <div class="detalhe-label">Transmissão</div>
                    <div class="detalhe-valor">@Model.Transmissao</div>
                </div>
                <div class="detalhe-item">
                    <div class="detalhe-label">Condição</div>
                    <div class="detalhe-valor">@Model.Condicao</div>
                </div>
            </div>

            <p class="resultado-aviso">
                ⚠ Esta avaliação é uma estimativa baseada em dados de mercado.
                O valor real pode variar consoante o estado do veículo, extras e procura local.
            </p>
        </div>

        
        <div style="text-align:center; margin-bottom: 24px;">
            <a href="/Auto/Vender?marca=@Uri.EscapeDataString(Model.Marca)&modelo=@Uri.EscapeDataString(Model.Modelo)&ano=@Model.Ano&preco=@Model.PrecoEstimado&combustivel=@Uri.EscapeDataString(Model.Combustivel)&transmissao=@Uri.EscapeDataString(Model.Transmissao)&condicao=@Uri.EscapeDataString(Model.Condicao)"
               class="btn-vender">
                Colocar à venda por €@Model.PrecoEstimado!.Value.ToString("N0") →
            </a>
        </div>
    }

    <form method="post">
        <div class="avaliar-card">
            <div class="avaliar-section-title">Dados do Veículo</div>
            <div class="avaliar-grid">
                <div class="form-group">
                    <label>Marca</label>
                    <input type="text" asp-for="Marca" placeholder="Ex: BMW" required />
                </div>
                <div class="form-group">
                    <label>Modelo</label>
                    <input type="text" asp-for="Modelo" placeholder="Ex: Serie 3" required />
                </div>
                <div class="form-group">
                    <label>Ano</label>
                    <input type="number" asp-for="Ano" placeholder="Ex: 2019"
                           min="1990" max="2026" required />
                </div>
                <div class="form-group">
                    <label>Quilómetros</label>
                    <input type="number" asp-for="Kilometragem" placeholder="Ex: 80000"
                           min="0" required />
                </div>
                <div class="form-group">
                    <label>Combustível</label>
                    <select asp-for="Combustivel" required>
                        <option value="">Selecionar</option>
                        <option value="Gasolina">Gasolina</option>
                        <option value="Diesel">Diesel</option>
                        <option value="Elétrico">Elétrico</option>
                        <option value="Híbrido">Híbrido</option>
                        <option value="GPL">GPL</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Transmissão</label>
                    <select asp-for="Transmissao" required>
                        <option value="">Selecionar</option>
                        <option value="Manual">Manual</option>
                        <option value="Automático">Automático</option>
                        <option value="Semi-automático">Semi-automático</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Condição</label>
                    <select asp-for="Condicao" required>
                        <option value="">Selecionar</option>
                        <option value="Novo">Novo</option>
                        <option value="Como novo">Como novo</option>
                        <option value="Bom estado">Bom estado</option>
                        <option value="Estado razoável">Estado razoável</option>
                        <option value="Para peças">Para peças</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Potência (cv) — opcional</label>
                    <input type="number" asp-for="Potencia" placeholder="Ex: 150" min="0" />
                </div>
            </div>
        </div>

        <button type="submit" class="btn-avaliar">Calcular Valor de Mercado</button>
    </form>
</div>