@page
@model AutoPrice.Pages.Admin.GerirModel
@{
    ViewData["Title"] = "Painel de Administração";
}

@section Styles {
    <style>
        .admin-wrap {
            max-width: 1100px;
            margin: 40px auto 80px;
            padding: 0 24px;
        }

        .admin-title {
            font-family: 'Barlow Condensed', sans-serif;
            font-size: 2.2rem;
            font-weight: 900;
            text-transform: uppercase;
            color: #fff;
            margin-bottom: 6px;
        }

            .admin-title span {
                color: #e63946;
            }

        .admin-sub {
            color: #888;
            font-size: .85rem;
            margin-bottom: 36px;
        }

        .admin-stats {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 16px;
            margin-bottom: 36px;
        }

        .stat-card {
            background: #1a1a1a;
            border: 1px solid #2a2a2a;
            border-radius: 12px;
            padding: 24px;
            text-align: center;
        }

        .stat-num {
            font-family: 'Barlow Condensed', sans-serif;
            font-size: 2.4rem;
            font-weight: 900;
            color: #c9a84c;
        }

        .stat-label {
            font-size: .8rem;
            color: #888;
            text-transform: uppercase;
            letter-spacing: .05em;
            margin-top: 4px;
        }

        .admin-tabs {
            display: flex;
            gap: 4px;
            background: #111;
            border: 1px solid #2a2a2a;
            border-radius: 10px;
            padding: 4px;
            margin-bottom: 24px;
            width: fit-content;
        }

        .tab-btn {
            background: transparent;
            border: none;
            color: #888;
            font-family: 'Barlow', sans-serif;
            font-size: .88rem;
            font-weight: 600;
            padding: 10px 24px;
            border-radius: 8px;
            cursor: pointer;
            transition: all .2s;
        }

            .tab-btn.active {
                background: #1a1a1a;
                color: #fff;
                border: 1px solid #2a2a2a;
            }

        .tab-panel {
            display: none;
        }

            .tab-panel.active {
                display: block;
            }

        .admin-table-wrap {
            background: #1a1a1a;
            border: 1px solid #2a2a2a;
            border-radius: 12px;
            overflow: hidden;
        }

        .admin-table {
            width: 100%;
            border-collapse: collapse;
        }

            .admin-table thead {
                background: #111;
            }

            .admin-table th {
                padding: 14px 18px;
                text-align: left;
                font-size: .75rem;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: .05em;
                color: #888;
                border-bottom: 1px solid #2a2a2a;
            }

            .admin-table td {
                padding: 14px 18px;
                font-size: .88rem;
                color: #ccc;
                border-bottom: 1px solid #1f1f1f;
                vertical-align: middle;
            }

            .admin-table tr:last-child td {
                border-bottom: none;
            }

            .admin-table tr:hover td {
                background: rgba(255,255,255,.02);
            }

        .u-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid #2a2a2a;
            vertical-align: middle;
            margin-right: 10px;
        }

        .v-thumb {
            width: 48px;
            height: 34px;
            object-fit: cover;
            border-radius: 6px;
            vertical-align: middle;
            margin-right: 10px;
        }

        .u-name {
            font-weight: 600;
            color: #fff;
        }

        .row-actions {
            display: flex;
            gap: 8px;
        }

        .btn-del, .btn-edit {
            border-radius: 6px;
            padding: 6px 14px;
            font-size: .78rem;
            font-weight: 600;
            cursor: pointer;
            transition: all .2s;
            font-family: 'Barlow', sans-serif;
        }

        .btn-del {
            background: rgba(230,57,70,.1);
            border: 1px solid rgba(230,57,70,.3);
            color: #e63946;
        }

            .btn-del:hover {
                background: #e63946;
                color: #fff;
            }

        .btn-edit {
            background: rgba(201,168,76,.1);
            border: 1px solid rgba(201,168,76,.35);
            color: #c9a84c;
        }

            .btn-edit:hover {
                background: #c9a84c;
                color: #000;
            }

        .admin-search {
            background: #111;
            border: 1px solid #2a2a2a;
            border-radius: 8px;
            padding: 10px 16px;
            color: #fff;
            font-family: 'Barlow', sans-serif;
            font-size: .88rem;
            width: 280px;
            margin-bottom: 16px;
        }

            .admin-search:focus {
                outline: none;
                border-color: #c9a84c;
            }

        .sucesso-banner {
            background: rgba(0,201,122,.1);
            border: 1px solid rgba(0,201,122,.3);
            color: #00c97a;
            border-radius: 8px;
            padding: 12px 18px;
            margin-bottom: 20px;
            font-size: .88rem;
            font-weight: 600;
        }

        .erro-banner {
            background: rgba(230,57,70,.1);
            border: 1px solid rgba(230,57,70,.3);
            color: #e63946;
            border-radius: 8px;
            padding: 12px 18px;
            margin-bottom: 20px;
            font-size: .88rem;
            font-weight: 600;
        }

        .modal-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,.6);
            z-index: 1000;
            align-items: center;
            justify-content: center;
        }

            .modal-overlay.active {
                display: flex;
            }

        .modal-box {
            background: #1a1a1a;
            border: 1px solid #2a2a2a;
            border-radius: 14px;
            padding: 28px;
            width: 100%;
            max-width: 440px;
            max-height: 86vh;
            overflow-y: auto;
        }

            .modal-box h3 {
                font-family: 'Barlow Condensed', sans-serif;
                font-size: 1.4rem;
                font-weight: 900;
                text-transform: uppercase;
                color: #fff;
                margin-bottom: 20px;
            }

            .modal-box .form-group {
                margin-bottom: 14px;
            }

            .modal-box label {
                display: block;
                font-size: .78rem;
                color: #888;
                text-transform: uppercase;
                letter-spacing: .04em;
                margin-bottom: 6px;
            }

            .modal-box input,
            .modal-box select,
            .modal-box textarea {
                width: 100%;
                background: #111;
                border: 1px solid #2a2a2a;
                border-radius: 8px;
                padding: 10px 12px;
                color: #fff;
                font-family: 'Barlow', sans-serif;
                font-size: .88rem;
            }

                .modal-box input:focus,
                .modal-box select:focus,
                .modal-box textarea:focus {
                    outline: none;
                    border-color: #c9a84c;
                }

        .modal-grid-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }

        .modal-actions {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            margin-top: 20px;
        }

        .btn-cancel {
            background: transparent;
            border: 1px solid #2a2a2a;
            color: #888;
            border-radius: 8px;
            padding: 10px 20px;
            font-family: 'Barlow', sans-serif;
            font-size: .88rem;
            font-weight: 600;
            cursor: pointer;
        }

        .btn-salvar {
            background: #c9a84c;
            border: none;
            color: #000;
            border-radius: 8px;
            padding: 10px 20px;
            font-family: 'Barlow', sans-serif;
            font-size: .88rem;
            font-weight: 700;
            cursor: pointer;
        }

        .ea-img-preview {
            max-width: 100%;
            border-radius: 8px;
            margin-bottom: 10px;
            display: none;
        }

        @@media (max-width: 700px) {
            .admin-stats {
                grid-template-columns: 1fr;
            }

            .modal-grid-2 {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<div class="admin-wrap">
    <div class="admin-title">Painel de <span>Administração</span></div>
    <div class="admin-sub">Gestão de utilizadores e publicações da plataforma</div>

    @if (TempData["Sucesso"] != null)
    {
        <div class="sucesso-banner">✓ @TempData["Sucesso"]</div>
    }
    @if (TempData["Erro"] != null)
    {
        <div class="erro-banner">⚠ @TempData["Erro"]</div>
    }

    <!-- Estatísticas -->
    <div class="admin-stats">
        <div class="stat-card">
            <div class="stat-num">@Model.Utilizadores.Count</div>
            <div class="stat-label">Utilizadores Registados</div>
        </div>
        <div class="stat-card">
            <div class="stat-num">@Model.Veiculos.Count</div>
            <div class="stat-label">Anúncios Publicados</div>
        </div>
    </div>

    <!-- Tabs -->
    <div class="admin-tabs">
        <button class="tab-btn active" onclick="switchTab('utilizadores', this)">
            👥 Utilizadores (@Model.Utilizadores.Count)
        </button>
        <button class="tab-btn" onclick="switchTab('anuncios', this)">
            🚗 Anúncios (@Model.Veiculos.Count)
        </button>
    </div>

    <!-- TAB: Utilizadores -->
    <div class="tab-panel active" id="tab-utilizadores">
        <input class="admin-search" type="text"
               placeholder="Pesquisar utilizador..."
               oninput="filtrarTabela(this, 'tbl-users')" />
        <div class="admin-table-wrap">
            <table class="admin-table" id="tbl-users">
                <thead>
                    <tr>
                        <th>Utilizador</th>
                        <th>Email</th>
                        <th>Anúncios</th>
                        <th>Membro desde</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model.Utilizadores)
                    {
                        var avatarUrl = string.IsNullOrEmpty(u.FotoUrl)
                        ? "https://ui-avatars.com/api/?name=" + Uri.EscapeDataString(u.NomeCompleto ?? u.Email ?? "?") + "&background=2a2a2a&color=888&size=80"
                        : u.FotoUrl;

                        <tr>
                            <td>
                                <img class="u-avatar" src="@avatarUrl" alt="@u.NomeCompleto" />
                                <span class="u-name">@(u.NomeCompleto ?? "—")</span>
                            </td>
                            <td>@u.Email</td>
                            <td>@u.TotalAnuncios</td>
                            <td>@u.DataRegisto.ToString("dd/MM/yyyy")</td>
                            <td>
                                <div class="row-actions">
                                    <button class="btn-edit"
                                            data-id="@u.Id"
                                            data-nome="@u.NomeCompleto"
                                            data-email="@u.Email"
                                            data-localizacao="@u.Localizacao"
                                            onclick="abrirModalUtilizador(this)">
                                        Editar
                                    </button>
                                    @if (u.Id != Model.AdminId)
                                    {
                                        <form method="post" asp-page-handler="EliminarUtilizador"
                                              onsubmit="return confirm('Eliminar este utilizador e todos os seus anúncios?')">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@u.Id" />
                                            <button class="btn-del" type="submit">Eliminar</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span style="font-size:.75rem;color:#555;align-self:center;">Tu</span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- TAB: Anúncios -->
    <div class="tab-panel" id="tab-anuncios">
        <input class="admin-search" type="text"
               placeholder="Pesquisar anúncio..."
               oninput="filtrarTabela(this, 'tbl-anuncios')" />
        <div class="admin-table-wrap">
            <table class="admin-table" id="tbl-anuncios">
                <thead>
                    <tr>
                        <th>Veículo</th>
                        <th>Categoria</th>
                        <th>Vendedor</th>
                        <th>Preço</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var v in Model.Veiculos)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(v.ImagemUrl))
                                {
                                    <img class="v-thumb" src="@v.ImagemUrl" alt="@v.Marca @v.Modelo" />
                                }
                                <span class="u-name">@v.Marca @v.Modelo (@v.Ano)</span>
                            </td>
                            <td>@(v.Categoria ?? "—")</td>
                            <td>@(v.VendedorNome ?? v.VendedorEmail ?? "—")</td>
                            <td style="color:#c9a84c;font-weight:700;">€@v.Preco.ToString("N0")</td>
                            <td>
                                <div class="row-actions">
                                    <button class="btn-edit"
                                            data-id="@v.Id"
                                            data-titulo="@v.Titulo"
                                            data-marca="@v.Marca"
                                            data-modelo="@v.Modelo"
                                            data-ano="@v.Ano"
                                            data-preco="@v.Preco"
                                            data-categoriaid="@v.CategoriaId"
                                            data-km="@v.Kilometragem"
                                            data-descricao="@v.Descricao"
                                            data-combustivel="@v.Combustivel"
                                            data-condicao="@v.Condicao"
                                            data-imagemurl="@v.ImagemUrl"
                                            onclick="abrirModalAnuncio(this)">
                                        Editar
                                    </button>
                                    <form method="post" asp-page-handler="EliminarAnuncio"
                                          onsubmit="return confirm('Eliminar este anúncio?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@v.Id" />
                                        <button class="btn-del" type="submit">Eliminar</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- MODAL: Editar Utilizador -->
<div class="modal-overlay" id="modalUtilizador">
    <div class="modal-box">
        <h3>Editar Utilizador</h3>
        <form method="post" asp-page-handler="EditarUtilizador">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="eu-id" />
            <div class="form-group">
                <label>Nome completo</label>
                <input type="text" name="nomeCompleto" id="eu-nome" required />
            </div>
            <div class="form-group">
                <label>Email</label>
                <input type="email" name="email" id="eu-email" required />
            </div>
            <div class="form-group">
                <label>Localização</label>
                <input type="text" name="localizacao" id="eu-localizacao" />
            </div>
            <div class="form-group">
                <label>Nova Password</label>
                <input type="password" name="novaPassword" id="eu-password"
                       placeholder="Deixar em branco para não alterar" />
            </div>
            <div class="modal-actions">
                <button type="button" class="btn-cancel" onclick="fecharModal('modalUtilizador')">Cancelar</button>
                <button type="submit" class="btn-salvar">Guardar</button>
            </div>
        </form>
    </div>
</div>

<!-- MODAL: Editar Anúncio -->
<div class="modal-overlay" id="modalAnuncio">
    <div class="modal-box">
        <h3>Editar Anúncio</h3>
        <form method="post" asp-page-handler="EditarAnuncio" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="ea-id" />
            <input type="hidden" name="imagemUrlAtual" id="ea-imagem-atual" />

            <div class="form-group">
                <label>Imagem atual</label>
                <img id="ea-imagem-preview" class="ea-img-preview" src="" alt="" />
                <input type="file" name="novaImagem" id="ea-nova-imagem" accept="image/jpeg,image/png,image/webp" />
            </div>

            <div class="form-group">
                <label>Título</label>
                <input type="text" name="titulo" id="ea-titulo" required />
            </div>
            <div class="modal-grid-2">
                <div class="form-group">
                    <label>Marca</label>
                    <input type="text" name="marca" id="ea-marca" required />
                </div>
                <div class="form-group">
                    <label>Modelo</label>
                    <input type="text" name="modelo" id="ea-modelo" required />
                </div>
            </div>
            <div class="modal-grid-2">
                <div class="form-group">
                    <label>Ano</label>
                    <input type="number" name="ano" id="ea-ano" required />
                </div>
                <div class="form-group">
                    <label>Preço (€)</label>
                    <input type="number" step="0.01" name="preco" id="ea-preco" required />
                </div>
            </div>
            <div class="modal-grid-2">
                <div class="form-group">
                    <label>Categoria</label>
                    <select name="categoriaId" id="ea-categoria" required>
                        @foreach (var c in Model.Categorias)
                        {
                            <option value="@c.Id">@c.Nome</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>Quilometragem</label>
                    <input type="number" name="kilometragem" id="ea-km" />
                </div>
            </div>
            <div class="form-group">
                <label>Combustível</label>
                <input type="text" name="combustivel" id="ea-combustivel" />
            </div>
            <div class="form-group">
                <label>Condição</label>
                <input type="text" name="condicao" id="ea-condicao" />
            </div>
            <div class="form-group">
                <label>Descrição</label>
                <textarea name="descricao" id="ea-descricao" rows="3"></textarea>
            </div>
            <div class="modal-actions">
                <button type="button" class="btn-cancel" onclick="fecharModal('modalAnuncio')">Cancelar</button>
                <button type="submit" class="btn-salvar">Guardar</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function switchTab(nome, btn) {
            document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            document.getElementById('tab-' + nome).classList.add('active');
            btn.classList.add('active');
        }

        function filtrarTabela(input, tblId) {
            const termo = input.value.toLowerCase();
            document.querySelectorAll(`#${tblId} tbody tr`).forEach(tr => {
                tr.style.display = tr.textContent.toLowerCase().includes(termo) ? '' : 'none';
            });
        }

        function abrirModalUtilizador(btn) {
            document.getElementById('eu-id').value = btn.dataset.id;
            document.getElementById('eu-nome').value = btn.dataset.nome || '';
            document.getElementById('eu-email').value = btn.dataset.email || '';
            document.getElementById('eu-localizacao').value = btn.dataset.localizacao || '';
            document.getElementById('eu-password').value = ''; // nunca pré-preencher password
            document.getElementById('modalUtilizador').classList.add('active');
        }

        function abrirModalAnuncio(btn) {
            document.getElementById('ea-id').value = btn.dataset.id;
            document.getElementById('ea-titulo').value = btn.dataset.titulo || '';
            document.getElementById('ea-marca').value = btn.dataset.marca || '';
            document.getElementById('ea-modelo').value = btn.dataset.modelo || '';
            document.getElementById('ea-ano').value = btn.dataset.ano || '';
            document.getElementById('ea-preco').value = btn.dataset.preco || '';
            document.getElementById('ea-categoria').value = btn.dataset.categoriaid || '';
            document.getElementById('ea-km').value = btn.dataset.km || '';
            document.getElementById('ea-descricao').value = btn.dataset.descricao || '';
            document.getElementById('ea-combustivel').value = btn.dataset.combustivel || '';
            document.getElementById('ea-condicao').value = btn.dataset.condicao || '';
            document.getElementById('ea-imagem-atual').value = btn.dataset.imagemurl || '';
            document.getElementById('ea-nova-imagem').value = '';

            const preview = document.getElementById('ea-imagem-preview');
            if (btn.dataset.imagemurl) {
                preview.src = btn.dataset.imagemurl;
                preview.style.display = 'block';
            } else {
                preview.style.display = 'none';
            }

            document.getElementById('modalAnuncio').classList.add('active');
        }

        function fecharModal(id) {
            document.getElementById(id).classList.remove('active');
        }
    </script>
}