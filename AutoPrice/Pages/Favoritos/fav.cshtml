@page
@model AutoPrice.Pages.FavoritosPages.IndexModel

@{
    ViewData["Title"] = "Os meus Favoritos";
}

@section Styles {
    <link rel="stylesheet" href="~/css/perfil.css" asp-append-version="true" />
}

<div class="perfil-wrapper">

    <div class="perfil-section-title">Os meus <span>Favoritos</span></div>

    @if (Model.Favoritos.Any())
    {
        <div class="anuncios-grid">
            @foreach (var a in Model.Favoritos)
            {
                var fallback = "https://images.unsplash.com/photo-1556189250-72ba954cfc2b?w=400&auto=format&fit=crop";
                var imagemPrincipal = (a.Imagens != null && a.Imagens.Any()) ? a.Imagens[0] : fallback;
                <div class="anuncio-card" style="position:relative">
                    <form method="post" asp-page-handler="Remover" asp-route-id="@a.Id"
                          style="position:absolute;top:10px;right:10px;z-index:2">
                        <button type="submit" class="btn-remover-favorito"
                                title="Remover dos favoritos"
                                style="background:#e63946;color:#fff;border:none;width:32px;height:32px;border-radius:50%;font-size:16px;cursor:pointer;display:flex;align-items:center;justify-content:center">
                            ♥
                        </button>
                    </form>
                    <a asp-page="/Auto/Detalhes" asp-route-id="@a.Id" style="text-decoration:none;color:inherit">
                        <img class="anuncio-card-img" src="@imagemPrincipal" alt="@a.Marca @a.Modelo" />
                        <div class="anuncio-card-body">
                            <div class="anuncio-card-titulo">@a.Marca @a.Modelo</div>
                            <div class="anuncio-card-meta">
                                <span>@a.Ano</span>
                                @if (!string.IsNullOrEmpty(a.Combustivel))
                                {
                                    <span>@a.Combustivel</span>
                                }
                                @if (a.Kilometragem.HasValue)
                                {
                                    <span>@a.Kilometragem.Value.ToString("N0") km</span>
                                }
                            </div>
                            <div class="anuncio-card-preco">€@a.Preco.ToString("N0")</div>
                        </div>
                    </a>
                </div>
            }
        </div>
    }
    else
    {
        <div class="perfil-empty">
            <p>Ainda não tens nenhum anúncio nos favoritos.</p>
            <a asp-page="/Auto/Catalogo">Ver catálogo →</a>
        </div>
    }

</div>