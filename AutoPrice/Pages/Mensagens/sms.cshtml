@page "/Mensagens"
@model AutoPrice.Pages.MensagensModel
@{
    ViewData["Title"] = "Mensagens";
}

@section Styles {
    <link rel="stylesheet" href="~/css/mensagens.css" asp-append-version="true" />
}

<div class="msgs-layout">
    <div class="conversas-lista">
        <div class="conversas-titulo">💬 Mensagens</div>
        <div id="lista-conversas">
            @if (!Model.Conversas.Any())
            {
                <div class="sem-conversas">Ainda não tens mensagens.</div>
            }
            else
            {
                @foreach (var c in Model.Conversas)
                {
                    var ativa = Model.AnuncioIdInicial == c.AnuncioId && Model.OutroIdInicial == c.OutroId;
                    <a class="conversa-item @(ativa ? "ativa" : "")"
                       id="conv-@(c.AnuncioId)-@(c.OutroId)"
                       href="/Mensagens?anuncioId=@(c.AnuncioId)&outroId=@(c.OutroId)">
                        <div class="conversa-nome">
                            <span>@c.OutroNome</span>
                            @if (c.NaoLidas > 0 && !ativa)
                            {
                                <span class="badge-nao-lidas">@c.NaoLidas</span>
                            }
                        </div>
                        <div class="conversa-anuncio">@c.AnuncioTitulo</div>
                        <div class="conversa-ultima">@c.UltimaMensagem</div>
                    </a>
                }
            }
        </div>
    </div>

    <div class="chat-painel" id="chat-painel">
        <div class="chat-painel-header @(Model.AnuncioIdInicial.HasValue ? "visivel" : "")" id="chat-header">
            <div class="chat-painel-nome" id="chat-nome">@Model.OutroNomeInicial</div>
            <div class="chat-painel-sub" id="chat-sub">@Model.AnuncioTituloInicial</div>
            <div class="chat-painel-status" id="chat-status"></div>
        </div>
        <div class="chat-msgs" id="chat-msgs">
            @if (!Model.AnuncioIdInicial.HasValue)
            {
                <div class="chat-painel-vazio">Seleciona uma conversa</div>
            }
            else
            {
                @foreach (var m in Model.HistoricoInicial)
                {
                    var eMinha = m.RemetenteId == Model.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)!.Value;
                    <div class="chat-msg @(eMinha ? "meu" : "deles")">
                        @if (!eMinha)
                        {
                            <div class="msg-nome">@m.RemetenteNome</div>
                        }
                        <div>@m.Conteudo</div>
                        <div class="msg-hora">@m.EnviadoEm.ToLocalTime().ToString("HH:mm")</div>
                    </div>
                }
            }
        </div>
        <div class="chat-input-area @(Model.AnuncioIdInicial.HasValue ? "visivel" : "")" id="chat-input-area">
            <input type="text" id="chat-input" class="chat-input"
                   placeholder="Escreve uma mensagem…" maxlength="500" />
            <button class="btn-enviar" id="btn-enviar" onclick="enviarMensagem()">Enviar</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"
            crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script>
        // O chat continua a usar SignalR (é a exceção — precisa de ser em tempo
        // real). Tudo o resto desta página (lista de conversas, histórico) já vem
        // pronto do servidor no HTML, sem nenhum pedido fetch() extra.
        const API = "https://localhost:7224";

        function getToken() {
            const match = document.cookie.match(/(?:^|;\s*)token=([^;]*)/);
            return match ? decodeURIComponent(match[1]) : null;
        }

        const meuId = (() => {
            const match = document.cookie.match(/(?:^|;\s*)userId=([^;]*)/);
            return match ? decodeURIComponent(match[1]) : null;
        })();

        let connection = null;

        // A conversa ativa (se alguma) já vem definida pelo próprio servidor,
        // através dos parâmetros ?anuncioId=&outroId= do pedido atual.
        const params = new URLSearchParams(window.location.search);
        let conversaAtiva = null;
        const anuncioIdInicial = params.get("anuncioId");
        const outroIdInicial = params.get("outroId");
        if (anuncioIdInicial && outroIdInicial) {
            conversaAtiva = { anuncioId: parseInt(anuncioIdInicial), outroId: outroIdInicial };
        }

        async function ligarSignalR() {
            const token = getToken();
            if (!token) { definirStatus("Sem sessão.", ""); return; }

            connection = new signalR.HubConnectionBuilder()
                .withUrl(`${API}/hubs/chat`, { accessTokenFactory: () => token })
                .withAutomaticReconnect([0, 2000, 5000, 10000])
                .configureLogging(signalR.LogLevel.Warning)
                .build();

            connection.on("ReceberMensagem", (msg) => {
                if (conversaAtiva &&
                    msg.anuncioId == conversaAtiva.anuncioId &&
                    (msg.remetenteId === conversaAtiva.outroId || msg.remetenteId === meuId)) {
                    adicionarMensagem(msg);
                } else {
                    // Mensagem de outra conversa: só atualiza o item na lista (sem
                    // precisar de voltar a pedir a lista toda ao servidor).
                    atualizarItemLista(msg);
                }
            });

            connection.onreconnected(() => {
                definirStatus("Ligado ✓", "ligado");
                if (conversaAtiva) {
                    connection.invoke("EntrarNaSala", conversaAtiva.anuncioId, conversaAtiva.outroId)
                        .catch(e => console.warn("Re-EntrarNaSala:", e));
                }
            });

            connection.onclose(() => definirStatus("Ligação encerrada.", ""));

            try {
                await connection.start();
                definirStatus("Ligado ✓", "ligado");
                if (conversaAtiva) {
                    await connection.invoke("EntrarNaSala", conversaAtiva.anuncioId, conversaAtiva.outroId);
                }
            } catch (e) {
                console.error("Erro SignalR:", e);
                definirStatus("Erro de ligação.", "");
            }
        }

        function adicionarMensagem(msg) {
            const eMinha = msg.remetenteId === meuId;
            const div = document.createElement("div");
            div.className = "chat-msg " + (eMinha ? "meu" : "deles");
            const hora = new Date(msg.enviadoEm).toLocaleTimeString("pt-PT", { hour: "2-digit", minute: "2-digit" });
            div.innerHTML =
                (!eMinha ? `<div class="msg-nome">${escHtml(msg.remetenteNome)}</div>` : "") +
                `<div>${escHtml(msg.conteudo)}</div>` +
                `<div class="msg-hora">${hora}</div>`;
            const container = document.getElementById("chat-msgs");
            container.querySelector(".chat-painel-vazio")?.remove();
            container.appendChild(div);
            container.scrollTop = container.scrollHeight;
        }

        // Atualiza (ou realça) o item da lista correspondente à conversa que
        // recebeu a mensagem nova, só com manipulação local do DOM.
        function atualizarItemLista(msg) {
            const outroId = msg.remetenteId === meuId ? null : msg.remetenteId;
            if (!outroId) return;

            const item = document.querySelector(`.conversa-item[id^="conv-${msg.anuncioId}-"]`);
            if (!item) return; // conversa nova que ainda não existia na lista

            const ultima = item.querySelector(".conversa-ultima");
            if (ultima) ultima.textContent = msg.conteudo;

            let badge = item.querySelector(".badge-nao-lidas");
            if (!badge) {
                badge = document.createElement("span");
                badge.className = "badge-nao-lidas";
                item.querySelector(".conversa-nome")?.appendChild(badge);
            }
            badge.textContent = (parseInt(badge.textContent || "0") + 1).toString();

            item.parentElement?.prepend(item);
        }

        async function enviarMensagem() {
            if (!conversaAtiva) return;

            const input = document.getElementById("chat-input");
            const btnEnviar = document.getElementById("btn-enviar");
            const texto = input.value.trim();
            if (!texto) return;

            if (!connection || connection.state !== signalR.HubConnectionState.Connected) {
                definirStatus("Sem ligação. A tentar reconectar…", "");
                try {
                    await ligarSignalR();
                } catch (e) {
                    definirStatus("Erro de ligação.", "");
                    return;
                }
            }

            btnEnviar.disabled = true;
            try {
                await connection.invoke("EnviarMensagem", conversaAtiva.anuncioId, conversaAtiva.outroId, texto);
                input.value = "";
            } catch (e) {
                console.error("Erro ao enviar:", e);
                definirStatus("Erro ao enviar mensagem.", "");
            } finally {
                btnEnviar.disabled = false;
                input.focus();
            }
        }

        document.getElementById("chat-input")?.addEventListener("keydown", (e) => {
            if (e.key === "Enter" && !e.shiftKey) { e.preventDefault(); enviarMensagem(); }
        });

        function definirStatus(texto, tipo) {
            const el = document.getElementById("chat-status");
            if (!el) return;
            el.textContent = texto;
            el.className = "chat-painel-status " + tipo;
        }

        function escHtml(str) {
            if (!str) return "";
            return String(str).replace(/&/g, "&amp;").replace(/</g, "&lt;")
                              .replace(/>/g, "&gt;").replace(/"/g, "&quot;");
        }

        // Liga sempre ao SignalR ao abrir a página — mesmo sem conversa ativa,
        // para receber notificações em tempo real de novas mensagens.
        ligarSignalR();

        const containerMsgs = document.getElementById("chat-msgs");
        if (containerMsgs) containerMsgs.scrollTop = containerMsgs.scrollHeight;
    </script>
}
