@page "/Mensagens"
@model AutoPrice.Pages.MensagensModel
@{
    ViewData["Title"] = "Mensagens";
}

@section Styles {
    <style>
        .msgs-layout {
            display: grid;
            grid-template-columns: 320px 1fr;
            gap: 0;
            height: calc(100vh - 80px);
            max-width: 1100px;
            margin: 0 auto;
            padding: 20px 16px;
        }

        .conversas-lista {
            background: #12121e;
            border: 1px solid #2a2a4a;
            border-radius: 12px 0 0 12px;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
        }

        .conversas-titulo {
            padding: 16px;
            font-size: 0.8rem;
            font-weight: 700;
            color: #666;
            letter-spacing: .08em;
            text-transform: uppercase;
            border-bottom: 1px solid #2a2a4a;
        }

        .conversa-item {
            padding: 14px 16px;
            border-bottom: 1px solid #1a1a2e;
            cursor: pointer;
            transition: background .15s;
            display: flex;
            flex-direction: column;
            gap: 3px;
        }

            .conversa-item:hover, .conversa-item.ativa {
                background: #1a1a2e;
            }

            .conversa-item.ativa {
                border-left: 3px solid #e63946;
            }

        .conversa-nome {
            font-size: 0.9rem;
            font-weight: 600;
            color: #eee;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .conversa-anuncio {
            font-size: 0.75rem;
            color: #e63946;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .conversa-ultima {
            font-size: 0.78rem;
            color: #666;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .badge-nao-lidas {
            background: #e63946;
            color: #fff;
            font-size: 0.65rem;
            font-weight: 700;
            border-radius: 999px;
            min-width: 18px;
            height: 18px;
            line-height: 18px;
            text-align: center;
            padding: 0 4px;
            flex-shrink: 0;
        }

        .sem-conversas {
            padding: 32px 16px;
            text-align: center;
            color: #555;
            font-size: 0.85rem;
        }

        .chat-painel {
            background: #0d0d1a;
            border: 1px solid #2a2a4a;
            border-left: none;
            border-radius: 0 12px 12px 0;
            display: flex;
            flex-direction: column;
        }

        .chat-painel-vazio {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #444;
            font-size: 0.9rem;
        }

        .chat-painel-header {
            padding: 14px 16px;
            border-bottom: 1px solid #2a2a4a;
            display: none;
        }

            .chat-painel-header.visivel {
                display: block;
            }

        .chat-painel-nome {
            font-size: 0.95rem;
            font-weight: 700;
            color: #eee;
        }

        .chat-painel-sub {
            font-size: 0.75rem;
            color: #e63946;
            margin-top: 2px;
        }

        .chat-painel-status {
            font-size: 0.7rem;
            color: #555;
            margin-top: 2px;
        }

            .chat-painel-status.ligado {
                color: #4caf50;
            }

        .chat-msgs {
            flex: 1;
            overflow-y: auto;
            padding: 16px;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

            .chat-msgs::-webkit-scrollbar {
                width: 4px;
            }

            .chat-msgs::-webkit-scrollbar-thumb {
                background: #2a2a4a;
                border-radius: 4px;
            }

        .chat-msg {
            max-width: 70%;
            padding: 8px 12px;
            border-radius: 10px;
            font-size: 0.88rem;
            line-height: 1.4;
            word-break: break-word;
        }

            .chat-msg.meu {
                align-self: flex-end;
                background: #e63946;
                color: #fff;
                border-bottom-right-radius: 2px;
            }

            .chat-msg.deles {
                align-self: flex-start;
                background: #1a1a2e;
                color: #ccc;
                border-bottom-left-radius: 2px;
            }

            .chat-msg .msg-nome {
                font-size: 0.7rem;
                font-weight: 700;
                margin-bottom: 3px;
                opacity: 0.75;
            }

            .chat-msg .msg-hora {
                font-size: 0.68rem;
                opacity: 0.55;
                margin-top: 4px;
                text-align: right;
            }

        .chat-input-area {
            padding: 12px 16px;
            border-top: 1px solid #2a2a4a;
            display: none;
            gap: 8px;
        }

            .chat-input-area.visivel {
                display: flex;
            }

        .chat-input {
            flex: 1;
            background: #12121e;
            border: 1px solid #2a2a4a;
            border-radius: 8px;
            color: #fff;
            padding: 8px 12px;
            font-size: 0.9rem;
            transition: border-color .2s;
        }

            .chat-input:focus {
                outline: none;
                border-color: #e63946;
            }

        .btn-enviar {
            background: #e63946;
            color: #fff;
            border: none;
            border-radius: 8px;
            padding: 8px 18px;
            font-size: 0.9rem;
            font-weight: 600;
            cursor: pointer;
            transition: opacity .2s;
        }

            .btn-enviar:hover {
                opacity: .85;
            }

        .btn-enviar:disabled {
            opacity: .45;
            cursor: not-allowed;
        }
    </style>
}

<div class="msgs-layout">
    <div class="conversas-lista">
        <div class="conversas-titulo">💬 Mensagens</div>
        <div id="lista-conversas">
            <div class="sem-conversas">A carregar…</div>
        </div>
    </div>

    <div class="chat-painel" id="chat-painel">
        <div class="chat-painel-header" id="chat-header">
            <div class="chat-painel-nome" id="chat-nome"></div>
            <div class="chat-painel-sub" id="chat-sub"></div>
            <div class="chat-painel-status" id="chat-status"></div>
        </div>
        <div class="chat-msgs" id="chat-msgs">
            <div class="chat-painel-vazio">Seleciona uma conversa</div>
        </div>
        <div class="chat-input-area" id="chat-input-area">
            <input type="text" id="chat-input" class="chat-input"
                   placeholder="Escreve uma mensagem…" maxlength="500" />
            <button class="btn-enviar" id="btn-enviar" onclick="enviarMensagem()">Enviar</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"
            crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script>
        const API = "https://localhost:7224";

        function getToken() {
            const match = document.cookie.match(/(?:^|;\s*)token=([^;]*)/);
            return match ? decodeURIComponent(match[1]) : null;
        }

        const meuId = (() => {
            const match = document.cookie.match(/(?:^|;\s*)userId=([^;]*)/);
            return match ? decodeURIComponent(match[1]) : null;
        })();

        let connection    = null;
        let conversaAtiva = null;
        let enviando      = false;

        // ── Carregar lista de conversas ───────────────────────────
        async function carregarConversas() {
            const token = getToken();
            const lista = document.getElementById("lista-conversas");

            if (!token) {
                lista.innerHTML = '<div class="sem-conversas">Sessão expirada. Faz login novamente.</div>';
                return;
            }

            try {
                const resp = await fetch(`${API}/api/chat/conversas`, {
                    headers: { "Authorization": "Bearer " + token }
                });

                if (!resp.ok) {
                    lista.innerHTML = '<div class="sem-conversas">Erro ao carregar conversas.</div>';
                    return;
                }

                const conversas = await resp.json();

                if (conversas.length === 0) {
                    lista.innerHTML = '<div class="sem-conversas">Ainda não tens mensagens.</div>';
                    return;
                }

                lista.innerHTML = conversas.map(c => `
                    <div class="conversa-item"
                         onclick="abrirConversa(${c.anuncioId}, '${escHtml(c.outroId)}', '${escHtml(c.outroNome)}', '${escHtml(c.anuncioTitulo)}')"
                         id="conv-${c.anuncioId}-${escHtml(c.outroId)}">
                        <div class="conversa-nome">
                            <span>${escHtml(c.outroNome)}</span>
                            ${c.naoLidas > 0 ? `<span class="badge-nao-lidas">${c.naoLidas}</span>` : ""}
                        </div>
                        <div class="conversa-anuncio">${escHtml(c.anuncioTitulo)}</div>
                        <div class="conversa-ultima">${escHtml(c.ultimaMensagem)}</div>
                    </div>
                `).join("");
            } catch (e) {
                console.error("Erro ao carregar conversas:", e);
                lista.innerHTML = '<div class="sem-conversas">Erro de ligação ao servidor.</div>';
            }
        }

        // ── Abrir conversa ────────────────────────────────────────
        async function abrirConversa(anuncioId, outroId, outroNome, anuncioTitulo) {
            conversaAtiva = { anuncioId, outroId, outroNome, anuncioTitulo };

            document.querySelectorAll(".conversa-item").forEach(el => el.classList.remove("ativa"));
            const item = document.getElementById(`conv-${anuncioId}-${outroId}`);
            if (item) {
                item.classList.add("ativa");
                item.querySelector(".badge-nao-lidas")?.remove();
            }

            document.getElementById("chat-header").classList.add("visivel");
            document.getElementById("chat-input-area").classList.add("visivel");
            document.getElementById("chat-nome").textContent = outroNome;
            document.getElementById("chat-sub").textContent  = anuncioTitulo;
            document.getElementById("chat-msgs").innerHTML   = "";
            definirStatus("A ligar…", "");

            if (!connection || connection.state === signalR.HubConnectionState.Disconnected)
                await ligarSignalR();

            if (connection && connection.state === signalR.HubConnectionState.Connected) {
                try {
                    await connection.invoke("EntrarNaSala", anuncioId, outroId);
                } catch (e) {
                    console.warn("EntrarNaSala:", e);
                }
            }

            await carregarHistorico(anuncioId, outroId);
        }

        // ── SignalR ───────────────────────────────────────────────
        async function ligarSignalR() {
            const token = getToken();
            if (!token) { definirStatus("Sem sessão.", ""); return; }

            connection = new signalR.HubConnectionBuilder()
                .withUrl(`${API}/hubs/chat`, { accessTokenFactory: () => token })
                .withAutomaticReconnect([0, 2000, 5000, 10000])
                .configureLogging(signalR.LogLevel.Warning)
                .build();

            connection.on("ReceberMensagem", (msg) => {
                if (conversaAtiva &&
                    msg.anuncioId == conversaAtiva.anuncioId &&
                    (msg.remetenteId === conversaAtiva.outroId || msg.remetenteId === meuId)) {
                    adicionarMensagem(msg);
                }
                carregarConversas();
            });

            connection.onreconnected(() => {
                definirStatus("Ligado ✓", "ligado");
                if (conversaAtiva) {
                    connection.invoke("EntrarNaSala", conversaAtiva.anuncioId, conversaAtiva.outroId)
                        .catch(e => console.warn("Re-EntrarNaSala:", e));
                }
            });

            connection.onclose(() => definirStatus("Ligação encerrada.", ""));

            try {
                await connection.start();
                definirStatus("Ligado ✓", "ligado");
            } catch (e) {
                console.error("Erro SignalR:", e);
                definirStatus("Erro de ligação.", "");
            }
        }

        // ── Histórico ─────────────────────────────────────────────
        async function carregarHistorico(anuncioId, outroId) {
            const token = getToken();
            if (!token) return;
            try {
                const resp = await fetch(`${API}/api/chat/${anuncioId}/${outroId}`, {
                    headers: { "Authorization": "Bearer " + token }
                });
                if (resp.ok) { const msgs = await resp.json(); msgs.forEach(adicionarMensagem); }
            } catch (e) { console.warn("Histórico indisponível:", e); }
        }

        // ── Renderizar mensagem ───────────────────────────────────
        function adicionarMensagem(msg) {
            const eMinha = msg.remetenteId === meuId;
            const div = document.createElement("div");
            div.className = "chat-msg " + (eMinha ? "meu" : "deles");
            const hora = new Date(msg.enviadoEm).toLocaleTimeString("pt-PT", { hour: "2-digit", minute: "2-digit" });
            div.innerHTML =
                (!eMinha ? `<div class="msg-nome">${escHtml(msg.remetenteNome)}</div>` : "") +
                `<div>${escHtml(msg.conteudo)}</div>` +
                `<div class="msg-hora">${hora}</div>`;
            const container = document.getElementById("chat-msgs");
            container.querySelector(".chat-painel-vazio")?.remove();
            container.appendChild(div);
            container.scrollTop = container.scrollHeight;
        }

        // ── Enviar ────────────────────────────────────────────────
        async function enviarMensagem() {
            if (!conversaAtiva || enviando) return;

            const input = document.getElementById("chat-input");
            const btnEnviar = document.getElementById("btn-enviar");
            const texto = input.value.trim();
            if (!texto) return;

            if (!connection || connection.state !== signalR.HubConnectionState.Connected) {
                definirStatus("Sem ligação. A tentar reconectar…", "");
                try {
                    await ligarSignalR();
                    await connection.invoke("EntrarNaSala", conversaAtiva.anuncioId, conversaAtiva.outroId);
                } catch (e) {
                    definirStatus("Erro de ligação.", "");
                    return;
                }
            }

            enviando = true;
            btnEnviar.disabled = true;

            try {
                await connection.invoke("EnviarMensagem", conversaAtiva.anuncioId, conversaAtiva.outroId, texto);
                input.value = "";
            } catch (e) {
                console.error("Erro ao enviar:", e);
                definirStatus("Erro ao enviar mensagem.", "");
            } finally {
                enviando = false;
                btnEnviar.disabled = false;
                input.focus();
            }
        }

        document.getElementById("chat-input")?.addEventListener("keydown", (e) => {
            if (e.key === "Enter" && !e.shiftKey) { e.preventDefault(); enviarMensagem(); }
        });

        function definirStatus(texto, tipo) {
            const el = document.getElementById("chat-status");
            if (!el) return;
            el.textContent = texto;
            el.className = "chat-painel-status " + tipo;
        }

        function escHtml(str) {
            if (!str) return "";
            return String(str).replace(/&/g, "&amp;").replace(/</g, "&lt;")
                              .replace(/>/g, "&gt;").replace(/"/g, "&quot;");
        }

        // ── Init ──────────────────────────────────────────────────
        const params       = new URLSearchParams(window.location.search);
        const urlAnuncioId = params.get("anuncioId");
        const urlOutroId   = params.get("outroId");

        carregarConversas().then(async () => {
            if (urlAnuncioId && urlOutroId) {
                const token = getToken();
                if (!token) return;
                try {
                    const resp = await fetch(`${API}/api/anuncios/${urlAnuncioId}`, {
                        headers: { "Authorization": "Bearer " + token }
                    });
                    const anuncio = resp.ok ? await resp.json() : null;
                    const titulo  = anuncio?.titulo ?? "Anúncio";

                    const item   = document.getElementById(`conv-${urlAnuncioId}-${urlOutroId}`);
                    const nomeEl = item?.querySelector(".conversa-nome span");
                    const nome   = nomeEl?.textContent ?? anuncio?.vendedorNome ?? "Vendedor";

                    await abrirConversa(parseInt(urlAnuncioId), urlOutroId, nome, titulo);
                } catch (e) {
                    console.warn("Erro ao abrir conversa automática:", e);
                }
            }
        });
    </script>
}