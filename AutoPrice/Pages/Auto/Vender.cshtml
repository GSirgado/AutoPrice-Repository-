@page
@model AutoPrice.Pages.VenderModel

@{
    ViewData["Title"] = Model.ModoEdicao ? "Editar Anúncio" : "Vender Veículo";
}

@section Styles {
    <link rel="stylesheet" href="~/css/vender.css" asp-append-version="true" />
}

<div class="vender-wrapper">
    <h1 class="vender-title">@(Model.ModoEdicao ? "Editar" : "Publicar") <span>Anúncio</span></h1>
    <p class="vender-sub">@(Model.ModoEdicao ? "Atualiza os detalhes do teu veículo." : "Preenche os detalhes do teu veículo para o colocar à venda.")</p>

    @if (!string.IsNullOrEmpty(Model.Sucesso))
    {
        <div class="vender-alert sucesso">✓ @Model.Sucesso</div>
    }

    @if (!string.IsNullOrEmpty(Model.Erro))
    {
        <div class="vender-alert erro">✕ @Model.Erro</div>
    }

    @if (Request.Cookies["token"] == null)
    {
        <div class="vender-info">
            Tens de <a asp-page="/Auth/Login" style="color:#c9a84c">iniciar sessão</a> para publicar um anúncio.
        </div>
    }

    <form method="post" id="formVender" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ImagensUrls" id="imagensUrls" />
        <input type="hidden" asp-for="AnuncioId" />

        <div class="vender-card">

            <!-- FOTOS DO VEÍCULO -->
            <div class="vender-section">
                <div class="vender-section-title">Fotos do Veículo</div>
                <div class="upload-area" id="uploadArea">
                    <input type="file" id="ficheiro" name="NovosFicheiros" accept="image/jpeg,image/png,image/webp"
                           multiple onchange="selecionarImagens(this)" />
                    <div class="upload-icon">📷</div>
                    <div class="upload-text">
                        Clica para selecionar fotos (podes escolher várias)<br />
                        <span>JPG, PNG ou WEBP</span> — máximo 5MB cada
                    </div>
                </div>
                <div class="upload-preview-grid" id="uploadPreviewGrid"></div>
            </div>

            <!-- INFORMAÇÕES GERAIS -->
            <div class="vender-section">
                <div class="vender-section-title">Informações Gerais</div>
                <div class="vender-grid">
                    <div class="form-group full">
                        <label>Título do Anúncio</label>
                        <input type="text" asp-for="Titulo"
                               placeholder="Ex: BMW Série 3 320d - Excelente estado" required />
                    </div>
                    <div class="form-group">
                        <label>Tipo de Veículo</label>
                        @if (Model.ModoEdicao)
                        {
                            <select id="selectTipo" name="Tipo" disabled="disabled">
                                <option value="Carro" selected="@(Model.Tipo == "Carro")">Carro</option>
                                <option value="Mota" selected="@(Model.Tipo == "Mota")">Mota</option>
                            </select>
                            <input type="hidden" name="Tipo" value="@Model.Tipo" />
                        }
                        else
                        {
                            <select id="selectTipo" name="Tipo">
                                <option value="Carro" selected="@(Model.Tipo == "Carro")">Carro</option>
                                <option value="Mota" selected="@(Model.Tipo == "Mota")">Mota</option>
                            </select>
                        }
                    </div>
                    <div class="form-group">
                        <label>Categoria</label>
                        <select id="selectCategoria" asp-for="CategoriaId" required>
                            <option value="">Selecionar categoria</option>
                            @foreach (var cat in Model.TodasCategorias)
                            {
                                <option value="@cat.Id"
                                        data-tipo="@cat.Tipo"
                                        style="@(cat.Tipo != Model.Tipo ? "display:none" : "")">@cat.Nome</option>
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Condição</label>
                        <select asp-for="Condicao">
                            <option value="">Selecionar</option>
                            <option value="Novo">Novo</option>
                            <option value="Usado">Usado</option>
                            <option value="Para peças">Para peças</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- DADOS DO VEÍCULO -->
            <div class="vender-section">
                <div class="vender-section-title">Dados do Veículo</div>
                <div class="vender-grid">
                    <div class="form-group">
                        <label>Marca</label>
                        <input type="text" asp-for="Marca" placeholder="Ex: BMW" required />
                    </div>
                    <div class="form-group">
                        <label>Modelo</label>
                        <input type="text" asp-for="Modelo" placeholder="Ex: Série 3" required />
                    </div>
                    <div class="form-group">
                        <label>Ano</label>
                        <input type="number" asp-for="Ano" placeholder="Ex: 2020"
                               min="1900" max="2026" required />
                    </div>
                    <div class="form-group">
                        <label>Quilómetros</label>
                        <input type="number" asp-for="Kilometragem" placeholder="Ex: 45000" min="0" />
                    </div>
                    <div class="form-group">
                        <label>Cor</label>
                        <input type="text" asp-for="Cor" placeholder="Ex: Preto" />
                    </div>
                    <div class="form-group">
                        <label>Potência (cv)</label>
                        <input type="number" asp-for="Potencia" placeholder="Ex: 150" min="0" />
                    </div>
                </div>
            </div>

            <!-- MOTOR E TRANSMISSÃO -->
            <div class="vender-section">
                <div class="vender-section-title">Motor e Transmissão</div>
                <div class="vender-grid">
                    <div class="form-group">
                        <label>Combustível</label>
                        <select asp-for="Combustivel">
                            <option value="">Selecionar</option>
                            <option value="Gasolina">Gasolina</option>
                            <option value="Diesel">Diesel</option>
                            <option value="Elétrico">Elétrico</option>
                            <option value="Híbrido">Híbrido</option>
                            <option value="GPL">GPL</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Transmissão</label>
                        <select asp-for="Transmissao">
                            <option value="">Selecionar</option>
                            <option value="Manual">Manual</option>
                            <option value="Automático">Automático</option>
                            <option value="Semi-automático">Semi-automático</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- PREÇO E LOCALIZAÇÃO -->
            <div class="vender-section">
                <div class="vender-section-title">Preço e Localização</div>
                <div class="vender-grid">
                    <div class="form-group">
                        <label>Preço (€)</label>
                        <input type="number" asp-for="Preco" placeholder="Ex: 2500"
                               min="0" step="1" required />
                    </div>
                    <div class="form-group">
                        <label>Localização</label>
                        <input type="text" asp-for="Localizacao" placeholder="Ex: Lisboa" required />
                    </div>
                </div>
            </div>

            <!-- DESCRIÇÃO -->
            <div class="vender-section">
                <div class="vender-section-title">Descrição</div>
                <div class="form-group">
                    <label>Descrição do Veículo</label>
                    <textarea asp-for="Descricao"
                              placeholder="Descreve o estado do veículo, histórico de manutenção, extras incluídos..."></textarea>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.Sucesso))
            {
                <div class="vender-alert sucesso">✓ @Model.Sucesso</div>
            }
            @if (!string.IsNullOrEmpty(Model.Erro))
            {
                <div class="vender-alert erro">✕ @Model.Erro</div>
            }

            <button type="submit" class="btn-publicar">@(Model.ModoEdicao ? "Guardar Alterações" : "Publicar Anúncio")</button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        // Imagens que já estavam publicadas (modo edição) — guardadas no campo
        // escondido "ImagensUrls" para irem juntas no POST do formulário.
        let imagensExistentes = @Html.Raw(
                                                                            string.IsNullOrEmpty(Model.ImagensUrls)
                                                                            ? "[]"
                                                                            : System.Text.Json.JsonSerializer.Serialize(
                                                                                                            Model.ImagensUrls.Split(',').Where(u => !string.IsNullOrWhiteSpace(u)).ToList())
                                            );

        // Ficheiros novos escolhidos agora — vivem dentro do próprio <input type="file">
        // do formulário (via DataTransfer) e só são enviados para o servidor quando o
        // utilizador submeter o formulário, tal como qualquer campo normal.
        let novosFicheiros = [];

        window.addEventListener('DOMContentLoaded', () => {
            renderizarPreviews();
        });

        function selecionarImagens(input) {
            novosFicheiros = novosFicheiros.concat(Array.from(input.files));
            atualizarInputFicheiros();
            renderizarPreviews();
        }

        // Reconstrói o FileList do input a partir do array local, para que o
        // botão "remover" também funcione nas fotos ainda não submetidas.
        function atualizarInputFicheiros() {
            const dt = new DataTransfer();
            novosFicheiros.forEach(f => dt.items.add(f));
            document.getElementById('ficheiro').files = dt.files;
        }

        function removerNovaImagem(indice) {
            novosFicheiros.splice(indice, 1);
            atualizarInputFicheiros();
            renderizarPreviews();
        }

        function removerImagemExistente(url) {
            imagensExistentes = imagensExistentes.filter(u => u !== url);
            document.getElementById('imagensUrls').value = imagensExistentes.join(',');
            renderizarPreviews();
        }

        function criarPreviewItem(url, ehCapa, aoRemover) {
            const div = document.createElement('div');
            div.className = 'preview-item';

            const img = document.createElement('img');
            img.src = url;
            img.alt = 'Preview';
            div.appendChild(img);

            if (ehCapa) {
                const capa = document.createElement('span');
                capa.className = 'preview-item-cover';
                capa.textContent = 'Capa';
                div.appendChild(capa);
            }

            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'preview-item-remove';
            btn.textContent = '✕';
            btn.onclick = aoRemover;
            div.appendChild(btn);

            return div;
        }

        function renderizarPreviews() {
            const grid = document.getElementById('uploadPreviewGrid');
            grid.innerHTML = '';
            let primeira = true;

            imagensExistentes.forEach(url => {
                grid.appendChild(criarPreviewItem(url, primeira, () => removerImagemExistente(url)));
                primeira = false;
            });

            novosFicheiros.forEach((file, indice) => {
                const url = URL.createObjectURL(file);
                grid.appendChild(criarPreviewItem(url, primeira, () => removerNovaImagem(indice)));
                primeira = false;
            });

            document.getElementById('imagensUrls').value = imagensExistentes.join(',');
        }

        // Filtrar categorias por tipo (sem fetch - tudo já está no HTML)
        const selectTipo = document.getElementById('selectTipo');
        const selectCategoria = document.getElementById('selectCategoria');

        function filtrarCategorias(tipo) {
            let primeirVisivel = null;
            Array.from(selectCategoria.options).forEach(opt => {
                if (!opt.value) return; // placeholder
                const pertence = opt.dataset.tipo === tipo;
                opt.style.display = pertence ? '' : 'none';
                if (pertence && !primeirVisivel) primeirVisivel = opt;
            });
            // Se a categoria atual não pertence ao tipo, resetar
            const atual = selectCategoria.querySelector(`option[value="${selectCategoria.value}"]`);
            if (!atual || atual.style.display === 'none') {
                selectCategoria.value = '';
            }
        }

        if (selectTipo) {
            selectTipo.addEventListener('change', function () {
                filtrarCategorias(this.value);
            });
            // Aplicar filtro imediatamente no load
            filtrarCategorias(selectTipo.value);
        }
    </script>
}