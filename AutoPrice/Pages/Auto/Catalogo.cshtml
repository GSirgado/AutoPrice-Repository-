@page
@model AutoPrice.Pages.CatalogoModel
@using AutoPrice.ViewModels

@{
    ViewData["Title"] = "Catálogo de Veículos";
    var marcas = Model.Veiculos.Select(v => v.Marca).Distinct().OrderBy(m => m).ToList();
    var cats = Model.Veiculos.Select(v => v.Categoria).Where(c => !string.IsNullOrEmpty(c)).Distinct().OrderBy(c => c).ToList();
    var anoMin = Model.Veiculos.Any() ? Model.Veiculos.Min(v => v.Ano) : 2018;
    var anoMax = Model.Veiculos.Any() ? Model.Veiculos.Max(v => v.Ano) : 2025;
    var precoTeto = Model.Veiculos.Any() ? (int)Model.Veiculos.Max(v => v.Preco) : 150000;
    var precoStep = 1000;
}

@section Styles {
    <link rel="stylesheet" href="~/css/catalogo.css" asp-append-version="true" />
}

<div class="vl-header">
    <div class="vl-breadcrumb">
        <a asp-page="/Index">Início</a><span>›</span><span>Veículos</span>
    </div>
    <h1 class="vl-title">Veículos <span>Disponíveis</span></h1>
</div>

<div class="vl-layout">
    <aside class="vl-filters">
        <div class="vl-filters-title">Filtros</div>

        <div class="vl-filter-group">
            <label class="vl-filter-label">Tipo</label>
            <select class="vl-select" id="vl-tipo">
                <option value="">Todos</option>
                <option value="carro">Carro</option>
                <option value="mota">Mota</option>
            </select>
        </div>

        <div class="vl-filter-group">
            <label class="vl-filter-label">Preço</label>
            <div class="vl-two-col">
                <div class="vl-price-wrap">
                    <span class="cur">€</span>
                    <input type="number" class="vl-price-input" id="vl-preco-min" placeholder="Mín" min="0" />
                </div>
                <div class="vl-price-wrap">
                    <span class="cur">€</span>
                    <input type="number" class="vl-price-input" id="vl-preco-max" placeholder="Máx" min="0" />
                </div>
            </div>
            <input type="range" class="vl-range" id="vl-slider"
                   min="0" max="@precoTeto" value="@precoTeto" step="@precoStep" />
            <div class="vl-range-labels">
                <span>€0</span>
                <span id="vl-slider-val">€@precoTeto.ToString("N0")</span>
            </div>
        </div>

        <div class="vl-filter-group">
            <label class="vl-filter-label">Marca</label>
            <select class="vl-select" id="vl-marca">
                <option value="">Todas as marcas</option>
                @foreach (var m in marcas)
                {
                    <option value="@m.ToLower()">@m</option>
                }
            </select>
        </div>

        <div class="vl-filter-group">
            <label class="vl-filter-label">Ano de Fabrico</label>
            <div class="vl-two-col">
                <select class="vl-select" id="vl-ano-min">
                    <option value="">De</option>
                    @for (int y = anoMin; y <= anoMax; y++)
                    {
                        <option value="@y">@y</option>
                    }
                </select>
                <select class="vl-select" id="vl-ano-max">
                    <option value="">Até</option>
                    @for (int y = anoMin; y <= anoMax; y++)
                    {
                        <option value="@y">@y</option>
                    }
                </select>
            </div>
        </div>

        <div class="vl-filter-group">
            <label class="vl-filter-label">Categoria</label>
            <select class="vl-select" id="vl-cat">
                <option value="">Todas as categorias</option>
                @foreach (var c in cats)
                {
                    <option value="@c!.ToLower()">@c</option>
                }
            </select>
        </div>

        <button class="vl-btn vl-btn-apply" onclick="vlAplicar()">Aplicar Filtros</button>
        <button class="vl-btn vl-btn-clear" onclick="vlLimpar()">Limpar Filtros</button>
    </aside>

    <div>
        <div class="vl-chips" id="vl-chips"></div>
        <div class="vl-results-header">
            <div class="vl-count">A mostrar <strong id="vl-count">0</strong> veículos</div>
            <select class="vl-sort" onchange="vlOrdenar(this.value)">
                <option value="">Ordenar: Relevância</option>
                <option value="preco-asc">Preço: Mais baixo primeiro</option>
                <option value="preco-desc">Preço: Mais alto primeiro</option>
                <option value="ano-desc">Ano: Mais recente</option>
                <option value="ano-asc">Ano: Mais antigo</option>
            </select>
        </div>
        <div class="vl-grid" id="vl-grid">
            @foreach (var v in Model.Veiculos)
            {
                var fallback = "https://images.unsplash.com/photo-1617814076367-b759c7d7e738?w=500&auto=format&fit=crop";
                <a href="@v.DetalheUrl" class="vl-card"
                   data-tipo="@v.Tipo.ToLower()"
                   data-marca="@v.Marca.ToLower()"
                   data-ano="@v.Ano"
                   data-cat="@(v.Categoria?.ToLower())"
                   data-preco="@((int)v.Preco)">
                    <div class="vl-img-wrap">
                        <img src="@(string.IsNullOrEmpty(v.ImagemPath) ? fallback : v.ImagemPath)"
                             alt="@v.Marca @v.Modelo" loading="lazy" />
                        <span class="vl-tag-novo">@v.Tipo</span>
                    </div>
                    <div class="vl-body">
                        <div class="vl-meta">
                            <span>@v.Ano</span>
                            @if (!string.IsNullOrEmpty(v.Categoria))
                            {
                                <span>@v.Categoria</span>
                            }
                            @if (!string.IsNullOrEmpty(v.Combustivel))
                            {
                                <span>@v.Combustivel</span>
                            }
                        </div>
                        <h4>@v.Marca @v.Modelo</h4>
                        <div class="vl-price-row">
                            <span class="vl-price">€@v.Preco.ToString("N0")</span>
                        </div>
                        @if (v.Kilometragem.HasValue)
                        {
                            <div style="font-size:.8rem;color:#888;margin-bottom:10px;">@v.Kilometragem.Value.ToString("N0") km</div>
                        }
                        <span class="vl-btn-ver">Ver Oferta →</span>
                    </div>
                </a>
            }
            @if (!Model.Veiculos.Any())
            {
                <p class="vl-empty">Ainda não há veículos disponíveis no catálogo.</p>
            }
        </div>
    </div>
</div>

<script>
    (function () {
        const slider = document.getElementById('vl-slider');
        const sliderLbl = document.getElementById('vl-slider-val');
        const maxInit = parseInt(slider.max);

        slider.addEventListener('input', () => {
            sliderLbl.textContent = '€' + parseInt(slider.value).toLocaleString('pt-PT');
            document.getElementById('vl-preco-max').value = slider.value;
        });

        window.vlAplicar = function () {
            const tipo     = document.getElementById('vl-tipo').value;
            const marca    = document.getElementById('vl-marca').value;
            const cat      = document.getElementById('vl-cat').value;
            const anoMin   = parseInt(document.getElementById('vl-ano-min').value) || 0;
            const anoMax   = parseInt(document.getElementById('vl-ano-max').value) || 9999;
            const precoMin = parseInt(document.getElementById('vl-preco-min').value) || 0;
            const precoMax = parseInt(document.getElementById('vl-preco-max').value) || 9999999;
            let visible = 0;
            document.querySelectorAll('.vl-card').forEach(card => {
                const ok = (!tipo  || card.dataset.tipo  === tipo)
                        && (!marca || card.dataset.marca === marca)
                        && (!cat   || card.dataset.cat   === cat)
                        && parseInt(card.dataset.ano)   >= anoMin
                        && parseInt(card.dataset.ano)   <= anoMax
                        && parseInt(card.dataset.preco) >= precoMin
                        && parseInt(card.dataset.preco) <= precoMax;
                card.style.display = ok ? '' : 'none';
                if (ok) visible++;
            });
            document.getElementById('vl-count').textContent = visible;
            vlChips(tipo, marca, cat, anoMin, anoMax, precoMin, precoMax);
        };

        window.vlLimpar = function () {
            ['vl-tipo','vl-marca','vl-cat','vl-ano-min','vl-ano-max'].forEach(id => document.getElementById(id).value = '');
            document.getElementById('vl-preco-min').value = '';
            document.getElementById('vl-preco-max').value = '';
            slider.value = maxInit;
            sliderLbl.textContent = '€' + maxInit.toLocaleString('pt-PT');
            document.getElementById('vl-chips').innerHTML = '';
            document.querySelectorAll('.vl-card').forEach(c => c.style.display = '');
            document.getElementById('vl-count').textContent = document.querySelectorAll('.vl-card').length;
        };

        window.vlOrdenar = function (criterio) {
            const grid  = document.getElementById('vl-grid');
            const cards = Array.from(grid.querySelectorAll('.vl-card'));
            cards.sort((a, b) => {
                if (criterio === 'preco-asc')  return parseInt(a.dataset.preco) - parseInt(b.dataset.preco);
                if (criterio === 'preco-desc') return parseInt(b.dataset.preco) - parseInt(a.dataset.preco);
                if (criterio === 'ano-desc')   return parseInt(b.dataset.ano)   - parseInt(a.dataset.ano);
                if (criterio === 'ano-asc')    return parseInt(a.dataset.ano)   - parseInt(b.dataset.ano);
                return 0;
            });
            cards.forEach(c => grid.appendChild(c));
        };

        function vlChips(tipo, marca, cat, anoMin, anoMax, precoMin, precoMax) {
            const wrap = document.getElementById('vl-chips');
            wrap.innerHTML = '';
            if (tipo)  addChip(wrap, 'Tipo: ' + tipo.charAt(0).toUpperCase() + tipo.slice(1));
            if (marca) addChip(wrap, 'Marca: ' + marca.charAt(0).toUpperCase() + marca.slice(1));
            if (cat)   addChip(wrap, 'Categoria: ' + cat.charAt(0).toUpperCase() + cat.slice(1));
            if (anoMin > 0 || anoMax < 9999) addChip(wrap, 'Ano: ' + (anoMin||'—') + ' – ' + (anoMax < 9999 ? anoMax : '—'));
            if (precoMin > 0)       addChip(wrap, 'Preço mín: €' + precoMin.toLocaleString('pt-PT'));
            if (precoMax < 9999999) addChip(wrap, 'Preço máx: €' + precoMax.toLocaleString('pt-PT'));
        }

        function addChip(wrap, text) {
            const chip = document.createElement('div');
            chip.className = 'vl-chip';
            chip.innerHTML = text + '<button onclick="vlLimpar()">✕</button>';
            wrap.appendChild(chip);
        }

        document.getElementById('vl-count').textContent = document.querySelectorAll('.vl-card').length;

        // Aplicar filtro automático se vier tipo na URL
        const urlParams = new URLSearchParams(window.location.search);
        const tipoUrl = urlParams.get('tipo');
        if (tipoUrl) {
            const sel = document.getElementById('vl-tipo');
            Array.from(sel.options).forEach(opt => {
                if (opt.value.toLowerCase() === tipoUrl.toLowerCase()) {
                    sel.value = opt.value;
                }
            });
            vlAplicar();
        }
    })();
</script>