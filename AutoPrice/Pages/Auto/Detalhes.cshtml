@page "/Auto/Detalhes/{id:int}"
@model AutoPrice.Pages.AutoPages.DetalhesModel

@{
    ViewData["Title"] = Model.Anuncio?.Titulo ?? "Detalhes";
    var a = Model.Anuncio;

    var meuId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
    var eVendedor = !string.IsNullOrEmpty(a?.VendedorId) && a.VendedorId == meuId;
    var mostrarChat = User.Identity?.IsAuthenticated == true && !eVendedor && !string.IsNullOrEmpty(a?.VendedorId);
}

@section Styles {
    <link rel="stylesheet" href="~/css/detalhes.css" asp-append-version="true" />
}

@if (a == null)
{
    <p style="padding:40px;color:#fff">Veículo não encontrado.</p>
}
else
{
    <div class="breadcrumb">
        <a asp-page="/Index">Início</a><span>›</span>
        <span>@a.Marca</span><span>›</span>
        <span>@a.Titulo</span>
    </div>

    <div class="detail-layout">

        <!-- COLUNA ESQUERDA -->
        <div>
            <div class="main-image-wrap">
                @if (a.Imagens != null && a.Imagens.Any())
                {
                    <img id="main-img" src="@a.Imagens[0]" alt="@a.Titulo" />
                    if (a.Imagens.Count > 1)
                    {
                        <button class="slide-btn slide-prev" onclick="mudarImagem(-1)" type="button">‹</button>
                        <button class="slide-btn slide-next" onclick="mudarImagem(1)" type="button">›</button>
                    }
                }
                else
                {
                    <img id="main-img"
                         src="https://images.unsplash.com/photo-1556189250-72ba954cfc2b?w=900&auto=format&fit=crop"
                         alt="@a.Titulo" />
                }
                <span class="novo-tag">@a.Condicao</span>
            </div>

            @if (a.Imagens != null && a.Imagens.Count > 1)
            {
                <div class="thumbs-row">
                    @for (int i = 0; i < a.Imagens.Count; i++)
                    {
                        <img src="@a.Imagens[i]" class="thumb-item @(i == 0 ? "active" : "")"
                             onclick="irParaImagem(@i)" data-index="@i" />
                    }
                </div>
            }

            <div class="desc-block">
                <h3>Descrição</h3>
                <p>@a.Descricao</p>
            </div>
        </div>

        <!-- COLUNA DIREITA -->
        <div class="detail-panel">
            <div>
                <div class="car-marca">@a.Marca</div>
                <div class="car-title">@a.Titulo</div>
                <div class="car-sub">@a.Ano · @a.Combustivel · @a.Transmissao</div>
            </div>

            <div class="price-block">
                <div class="price-label">Preço</div>
                <div class="price-main">€@a.Preco.ToString("N0")</div>
            </div>

            <div class="specs-block">
                <div class="specs-title">Ficha Técnica</div>
                <div class="specs-grid">
                    <div class="spec-item"><div class="spec-label">Ano</div><div class="spec-value">@a.Ano</div></div>
                    <div class="spec-item"><div class="spec-label">Marca</div><div class="spec-value">@a.Marca</div></div>
                    <div class="spec-item"><div class="spec-label">Modelo</div><div class="spec-value">@a.Modelo</div></div>
                    <div class="spec-item"><div class="spec-label">Combustível</div><div class="spec-value">@(a.Combustivel ?? "—")</div></div>
                    <div class="spec-item"><div class="spec-label">Transmissão</div><div class="spec-value">@(a.Transmissao ?? "—")</div></div>
                    <div class="spec-item"><div class="spec-label">Quilómetros</div><div class="spec-value">@(a.Kilometragem.HasValue? a.Kilometragem + " km" : "—")</div></div>
                    <div class="spec-item"><div class="spec-label">Cor</div><div class="spec-value">@(a.Cor ?? "—")</div></div>
                    <div class="spec-item"><div class="spec-label">Potência</div><div class="spec-value">@(a.Potencia.HasValue? a.Potencia + " cv" : "—")</div></div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(a.VendedorNome))
            {
                <div class="vendedor-block">
                    <div class="specs-title">Vendedor</div>
                    <div class="vendedor-nome">@a.VendedorNome</div>
                </div>
            }

            @if (mostrarChat)
            {
                <a asp-page="/Mensagens/Index" asp-route-anuncioId="@a.Id" asp-route-outroId="@a.VendedorId"
                   class="btn-contacto"
                   style="width:100%;display:block;text-align:center;margin-top:12px;text-decoration:none">
                    💬 Contactar Vendedor
                </a>
            }

            @if (!User.Identity?.IsAuthenticated ?? true)
            {
                <p style="margin-top:12px;font-size:.85rem;color:#888">
                    <a asp-page="/Auth/Login" style="color:#e63946">Inicia sessão</a> para contactar o vendedor.
                </p>
            }

            @if (eVendedor)
            {
                <p style="margin-top:12px;font-size:.85rem;color:#888">Este é o teu anúncio.</p>
                <a asp-page="/Auto/Vender" asp-route-id="@a.Id"
                   style="width:100%;display:block;text-align:center;margin-top:12px;text-decoration:none;background:#e63946;color:#fff;padding:12px;border-radius:8px;font-weight:600">
                    ✏️ Editar Anúncio
                </a>
                <button type="button" onclick="eliminarAnuncio(@a.Id)"
                        style="width:100%;display:block;text-align:center;margin-top:8px;background:#333;color:#fff;padding:12px;border-radius:8px;font-weight:600;border:none;cursor:pointer">
                    🗑️ Eliminar Anúncio
                </button>
            }
        </div>
    </div>
}

@if (a?.Imagens != null && a.Imagens.Count > 1)
{
    <script>
        const imagensVeiculo = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(a.Imagens));
        let indiceAtual = 0;
        function mudarImagem(direcao) {
            indiceAtual += direcao;
            if (indiceAtual < 0) indiceAtual = imagensVeiculo.length - 1;
            if (indiceAtual >= imagensVeiculo.length) indiceAtual = 0;
            atualizarImagemPrincipal();
        }
        function irParaImagem(indice) { indiceAtual = indice; atualizarImagemPrincipal(); }
        function atualizarImagemPrincipal() {
            document.getElementById('main-img').src = imagensVeiculo[indiceAtual];
            document.querySelectorAll('.thumb-item').forEach((t, i) => t.classList.toggle('active', i === indiceAtual));
        }
    </script>
}

<script>
        async function eliminarAnuncio(id) {
        if (!confirm('Tens a certeza que queres eliminar este anúncio?')) return;

        const token = document.cookie.split(';').find(c => c.trim().startsWith('token='))?.split('=')[1];

        const response = await fetch(`https://localhost:7224/api/Anuncios/${id}`, {
            method: 'DELETE',
            headers: { 'Authorization': `Bearer ${token}` }
        });

        console.log('Status:', response.status);
        const texto = await response.text();
        console.log('Resposta:', texto);

        if (response.ok) {
            window.location.href = '/Auto/Catalogo';
        } else {
            alert('Erro ao eliminar o anúncio.');
        }
    
    }
</script>